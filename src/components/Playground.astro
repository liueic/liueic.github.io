---
import BoidsPlayground from './BoidsPlayground.astro';
import AntColony from './AntColony.astro';
import { Bird, Bug } from 'lucide-astro';
import SectionTitle from './SectionTitle.astro';
---

<section id="playground" class="pt-10">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
    <SectionTitle icon="crop3" zh="实验场 · Playground" en="Playground" />
    <div class="inline-flex items-center self-start gap-1 p-0.5 bg-[#f6e0a4] border border-[#d4a75f]" role="tablist" aria-label="Playground">
      <button type="button" class="filter-tab-btn gap-1.5" data-playground-tab="boids" data-active="true" role="tab" aria-selected="true">
        <Bird size={13} />
        Boids
      </button>
      <button type="button" class="filter-tab-btn gap-1.5" data-playground-tab="aco" data-active="false" role="tab" aria-selected="false">
        <Bug size={13} />
        ACO
      </button>
    </div>
  </div>

  <BoidsPlayground />
  <AntColony />

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-playground-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-playground-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-playground-tab');
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('data-active', String(active));
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-playground-panel') !== target);
        });
      });
    });

    if (window.location.hash === '#aco') {
      document.querySelector<HTMLButtonElement>('[data-playground-tab="aco"]')?.click();
    }
  </script>
</section>
