---
import { Play, Pause, Shuffle, MousePointer2 } from 'lucide-astro';
---

<div data-playground-panel="aco" class="hidden">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
    <p class="text-xs sm:text-sm text-[#8a5a2b] text-pretty">
      <span data-i18n="zh">蚁群觅食（WebGPU）：蚂蚁从巢穴出发找食物，搬运时留下橙色“食物”信息素，觅食时留下蓝色“回巢”信息素；信息素扩散并挥发，更短的路径被正反馈强化。</span>
      <span data-i18n="en">Ant foraging on WebGPU: ants leave blue "home" pheromone while searching and orange "food" pheromone while carrying. Trails diffuse and evaporate, so shorter routes are reinforced by positive feedback.</span>
    </p>
    <div class="flex items-center gap-1.5 shrink-0">
      <button id="aco-toggle" type="button" class="academic-action-link cursor-pointer">
        <span id="aco-icon-play" class="hidden"><Play size={12} /></span>
        <span id="aco-icon-pause"><Pause size={12} /></span>
        <span data-i18n="zh" id="aco-toggle-zh">暂停</span>
        <span data-i18n="en" id="aco-toggle-en">Pause</span>
      </button>
      <button id="aco-newmap" type="button" class="academic-action-link cursor-pointer">
        <Shuffle size={12} />
        <span data-i18n="zh">新地图</span>
        <span data-i18n="en">New Map</span>
      </button>
    </div>
  </div>

  <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-[#8a5a2b]">
    <span class="inline-flex items-center gap-1.5">
      <MousePointer2 size={12} />
      <span data-i18n="zh">在画布上拖动绘制：</span>
      <span data-i18n="en">Drag on the canvas to paint:</span>
    </span>
    <span class="inline-flex gap-1" role="group">
      <button type="button" class="filter-tab-btn" data-aco-brush="food" data-active="true">food</button>
      <button type="button" class="filter-tab-btn" data-aco-brush="wall" data-active="false">wall</button>
      <button type="button" class="filter-tab-btn" data-aco-brush="erase" data-active="false">erase</button>
    </span>
  </div>

  <div class="relative border border-[#d4a75f] bg-[#fdf0c8]">
    <canvas id="aco-canvas" class="pixel-canvas block w-full h-[260px] sm:h-[360px] cursor-crosshair touch-none"></canvas>
    <div id="aco-fallback" class="hidden p-8 text-center text-xs text-[#8a5a2b] font-mono">
      <span data-i18n="zh">此浏览器不支持 WebGPU。请使用最新版 Chrome / Edge / Safari 查看。</span>
      <span data-i18n="en">WebGPU is not available in this browser. Try a recent Chrome / Edge / Safari.</span>
    </div>
    <div id="aco-pane" class="sim-pane absolute top-2 right-2 w-[220px] max-sm:hidden"></div>
  </div>

  <div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-[11px] text-[#8a5a2b]">
    <span class="inline-flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-1.5 bg-[#e0561f]"></span>food trail</span>
      <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-1.5 bg-[#3b6fb6]"></span>home trail</span>
    </span>
    <span id="aco-status" class="font-mono"></span>
  </div>

  <script>
    import { Pane } from 'tweakpane';
    import * as EssentialsPlugin from '@tweakpane/plugin-essentials';
    import { mountSim } from '../lib/sim/mount';
    import type { AntParams } from '../lib/sim/ants';

    const canvas = document.getElementById('aco-canvas') as HTMLCanvasElement;
    const statusEl = document.getElementById('aco-status')!;
    const toggleBtn = document.getElementById('aco-toggle')!;
    const toggleZh = document.getElementById('aco-toggle-zh')!;
    const toggleEn = document.getElementById('aco-toggle-en')!;
    const playIcon = document.getElementById('aco-icon-play')!;
    const pauseIcon = document.getElementById('aco-icon-pause')!;
    const brushBtns = document.querySelectorAll<HTMLButtonElement>('[data-aco-brush]');

    let params: AntParams | null = null;

    const mount = mountSim({
      canvas,
      fallback: document.getElementById('aco-fallback')!,
      create: async () => {
        const { createAnts, defaultAntParams } = await import('../lib/sim/ants');
        params = defaultAntParams();
        const pane = new Pane({ container: document.getElementById('aco-pane')!, title: 'aco' });
        pane.registerPlugin(EssentialsPlugin);
        const fpsGraph = pane.addBlade({ view: 'fpsgraph', label: 'fps', rows: 2 }) as any;
        const sim = await createAnts(
          canvas,
          params,
          (s) => (statusEl.textContent = `${params!.count} ants · delivered ${s.delivered} · ${s.fps.toFixed(0)} fps`),
          { begin: () => fpsGraph.begin(), end: () => fpsGraph.end() },
        );
        const sync = () => sim.sync();
        pane.addBinding(params, 'sensorAngle', { min: 0.1, max: 1.5, step: 0.05 }).on('change', sync);
        pane.addBinding(params, 'sensorDistance', { min: 2, max: 16, step: 1 }).on('change', sync);
        pane.addBinding(params, 'turnRate', { min: 0.05, max: 1, step: 0.05 }).on('change', sync);
        pane.addBinding(params, 'speed', { min: 0.2, max: 1.5, step: 0.05 }).on('change', sync);
        pane.addBinding(params, 'evaporation', { min: 0.001, max: 0.03, step: 0.001 }).on('change', sync);
        pane.addBinding(params, 'diffusion', { min: 0, max: 0.5, step: 0.01 }).on('change', sync);
        pane.addBinding(params, 'stepsPerFrame', { min: 1, max: 6, step: 1 });
        pane
          .addBinding(params, 'count', { options: { '2048': 2048, '4096': 4096, '8192': 8192, '16384': 16384 } })
          .on('change', () => sim.reset(false));
        pane.expanded = false;
        return sim;
      },
      onReady: (sim) => {
        document.getElementById('aco-newmap')!.addEventListener('click', () => sim.reset(true));
        brushBtns.forEach((b) =>
          b.addEventListener('click', () => {
            params!.brush = b.dataset.acoBrush as AntParams['brush'];
            brushBtns.forEach((o) => o.setAttribute('data-active', String(o === b)));
          }),
        );
      },
    });

    toggleBtn.addEventListener('click', () => {
      mount.setPaused(!mount.paused);
      const p = mount.paused;
      playIcon.classList.toggle('hidden', !p);
      pauseIcon.classList.toggle('hidden', p);
      toggleZh.textContent = p ? '继续' : '暂停';
      toggleEn.textContent = p ? 'Resume' : 'Pause';
    });
  </script>
</div>
