---
import Sprite from './Sprite.astro';
interface Props {
  icon: string;
  zh: string;
  en: string;
  class?: string;
}
const { icon, zh, en, class: cls = '' } = Astro.props;
---

<h2 class:list={['sv-title flex items-center gap-3 flex-1 min-w-0 text-xl tracking-tight text-[#4a2a14]', cls]}>
  <span class="sv-icon-slot"><Sprite name={icon} scale={2} /></span>
  <span data-i18n="zh">{zh}</span>
  <span data-i18n="en">{en}</span>
</h2>
