---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sprite from '../components/Sprite.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { siteData } from '../data/cv';
import yishuPhoto from '../assets/yishu.jpg';

const { profile, researchInterests, publications, experiences, education, skills, honors } = siteData;
---

<BaseLayout>
  <!-- 1. Hero / Academic Bio Section -->
  <section id="about" class="pb-10 border-b border-[#d4a75f]">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-5 md:grid md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-7 md:gap-y-8">
        <!-- Left: Bio & Links -->
        <div class="contents">
          <div class="min-w-0 flex flex-col gap-3 md:col-start-2 md:row-start-1 md:self-center">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <h1 class="flex items-end gap-3 text-3xl sm:text-4xl tracking-tight text-[#4a2a14]">
              <Sprite name="tree" scale={3} sway class="origin-bottom" />
              <span>
                <span data-i18n="zh">{profile.name.zh}</span>
                <span data-i18n="en">{profile.name.en}</span>
                <span class="ml-2 text-lg sm:text-xl text-[#8a5a2b]">
                  <span data-i18n="zh">({profile.name.en})</span>
                  <span data-i18n="en">({profile.name.zh})</span>
                </span>
              </span>
            </h1>
            <span class="font-mono text-xs text-[#8a5a2b] whitespace-nowrap">
              ORCID: <a href={profile.orcidUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-[#b98a45] underline-offset-4 hover:text-[#4a2a14]">{profile.orcid}</a>
            </span>
          </div>

          <div class="space-y-1">
            <p class="text-base sm:text-lg font-medium text-[#4a2a14]">
              <span data-i18n="zh">{profile.headline.zh}</span>
              <span data-i18n="en">{profile.headline.en}</span>
            </p>
            <p class="text-sm font-medium text-[#8a5a2b]">
              <span data-i18n="zh">{profile.tagline.zh}</span>
              <span data-i18n="en">{profile.tagline.en}</span>
            </p>
          </div>
          </div>

          <div class="sv-dialog md:col-span-2 space-y-2">
            <span class="sv-nametag">{profile.alias}</span>
            <p class="text-sm sm:text-[15px] text-[#4a2a14] leading-relaxed text-pretty">
              <span data-i18n="zh">{profile.bio.zh}</span>
              <span data-i18n="en">{profile.bio.en}</span>
            </p>
            {profile.footnote && (
              <p class="text-xs text-[#8a5a2b] pt-1 border-t border-dashed border-[#d4a75f]">
                <span data-i18n="zh">{profile.footnote.zh}</span>
                <span data-i18n="en">{profile.footnote.en}</span>
              </p>
            )}
            <span class="sv-next" aria-hidden="true">▼</span>
          </div>

          <div class="space-y-1.5 text-xs text-[#6b4423] md:col-span-2">
            <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5">
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#8a5a2b]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
                <a
                  href={`mailto:${profile.email}`}
                  class="font-mono hover:text-[#4a2a14] hover:underline underline-offset-4 transition-colors"
                >
                  {profile.email}
                </a>
                {profile.altEmail && (
                  <>
                    <span class="text-[#b98a45] select-none">/</span>
                    <a
                      href={`mailto:${profile.altEmail}`}
                      class="font-mono hover:text-[#4a2a14] hover:underline underline-offset-4 transition-colors"
                    >
                      {profile.altEmail}
                    </a>
                  </>
                )}
              </span>

              <span class="text-[#b98a45] select-none">|</span>

              <a
                href={profile.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 hover:text-[#4a2a14] hover:underline underline-offset-4 transition-colors"
              >
                <svg class="w-3.5 h-3.5 text-[#8a5a2b]" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
                </svg>
                <span class="font-mono">github.com/liueic</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Stardew-style Wooden Portrait Frame -->
        <figure class="sv-portrait w-40 order-first self-start md:order-none md:w-auto md:col-start-1 md:row-start-1 md:self-center">
          <span class="sv-portrait-pin">
            <span data-i18n="zh">生活照</span>
            <span data-i18n="en">PORTRAIT</span>
          </span>
          <div class="sv-portrait-inner">
            <Image
              src={yishuPhoto}
              alt="这是一树 (Yishu Liu)"
              widths={[320, 480, 640]}
              sizes="(min-width: 768px) 144px, 160px"
              loading="eager"
              class="sv-portrait-img"
            />
          </div>
          <figcaption class="sv-portrait-caption">
            <span class="inline-flex items-center gap-1.5">
              <Sprite name="flower" scale={1.3} />
              <span data-i18n="zh">这是一树</span>
              <span data-i18n="en">Yishu Liu</span>
            </span>
            <span class="text-[#8a5a2b]">CNU</span>
          </figcaption>
        </figure>
      </div>

      <!-- Research Interests -->
      <div class="pt-1">
        <SectionTitle icon="pumpkin" zh="研究方向 · Research" en="Research Interests" class="mb-4" />
        <div class="grid grid-cols-1 sm:grid-cols-2 auto-rows-fr gap-3 text-sm text-[#6b4423]">
          {researchInterests.map((item) => (
            <div class="sv-quest-card flex items-start gap-2">
              <span class="sv-quest select-none" aria-hidden="true">!</span>
              <span class="leading-relaxed">
                <span data-i18n="zh">{item.zh}</span>
                <span data-i18n="en">{item.en}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Publications & Manuscripts Section -->
  <section id="publications" class="py-10 border-b border-[#d4a75f]">
    <div class="flex items-baseline justify-between mb-6">
      <SectionTitle icon="book" zh="论文发表 · Publications" en="Publications & Manuscripts" class="" />
      <span class="font-mono text-xs text-[#8a5a2b]">
        {publications.length} 项
      </span>
    </div>

    <div class="divide-y divide-[#d4a75f]">
      {publications.map((pub) => (
        <article class="py-5 first:pt-0 last:pb-0 grid grid-cols-1 sm:grid-cols-[150px_1fr] gap-3 sm:gap-6">
          <div class="text-xs text-[#8a5a2b] pt-0.5 space-y-1.5">
            <div class="sv-date">{pub.year}</div>
            <div class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-[#f6e0a4] text-[#4a2a14] font-medium text-[11px] whitespace-nowrap border border-[#d4a75f]">
              <span class="w-1.5 h-1.5 bg-[#4a2a14]"></span>
              <span data-i18n="zh">{pub.status.zh}</span>
              <span data-i18n="en">{pub.status.en}</span>
            </div>
          </div>

          <div class="space-y-2">
            <h3 class="text-base font-semibold text-[#4a2a14] leading-snug">
              <span data-i18n="zh">{pub.title.zh}</span>
              <span data-i18n="en">{pub.title.en}</span>
            </h3>

            <p class="text-sm text-[#6b4423]">
              <span class="font-medium text-[#4a2a14]">
                <span data-i18n="zh">刘一树 (Yishu Liu)</span>
                <span data-i18n="en">Yishu Liu</span>
              </span>
              <span class="text-[#b98a45] mx-1.5 select-none">/</span>
              <span data-i18n="zh">{pub.role.zh}</span>
              <span data-i18n="en">{pub.role.en}</span>
            </p>

            <p class="text-xs sm:text-sm text-[#6b4423] leading-relaxed text-pretty">
              <span class="font-medium text-[#4a2a14]">{pub.venue.en}</span>
              <span class="text-[#b98a45] mx-1.5 select-none">—</span>
              <span class="text-[#8a5a2b]">
                <span data-i18n="zh">{pub.summary.zh}</span>
                <span data-i18n="en">{pub.summary.en}</span>
              </span>
            </p>

            <div class="flex flex-wrap items-center gap-1.5 pt-1">
              {pub.tags.map((tag) => (
                <span class="academic-tag">{tag}</span>
              ))}
              {pub.links &&
                pub.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="academic-action-link"
                  >
                    <span data-i18n="zh">{link.label.zh} ↗</span>
                    <span data-i18n="en">{link.label.en} ↗</span>
                  </a>
                ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 3. Research & Open-Source Experience Section -->
  <section id="experience" class="py-10 border-b border-[#d4a75f]">
    <div class="flex flex-col gap-4 mb-6">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <SectionTitle icon="pickaxe" zh="科研与开源经历 · Projects" en="Research & Open-Source Projects" class="" />
        <span id="project-count-label" class="font-mono text-xs text-[#8a5a2b]">
          {experiences.length} / {experiences.length}
        </span>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="academic-search-box w-full sm:max-w-xs">
          <svg class="w-4 h-4 text-[#8a5a2b] shrink-0 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          <input
            id="project-search-input"
            type="text"
            placeholder="搜索关键词 / Filter, e.g. Nextflow, MCP…"
            class="w-full text-xs sm:text-sm bg-transparent text-[#4a2a14] placeholder-[#8a5a2b] focus:outline-none"
          />
          <button
            id="project-search-clear"
            type="button"
            class="hidden text-xs text-[#8a5a2b] hover:text-[#4a2a14] ml-1 cursor-pointer"
            aria-label="Clear search"
          >
            ✕
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-1 p-0.5 bg-[#f6e0a4] border border-[#d4a75f]" role="tablist" aria-label="Category filter">
          <button type="button" class="filter-tab-btn" data-filter="all" data-active="true">
            <span data-i18n="zh">全部</span>
            <span data-i18n="en">All</span>
          </button>
          <button type="button" class="filter-tab-btn" data-filter="research" data-active="false">
            <span data-i18n="zh">科研实验室</span>
            <span data-i18n="en">Research</span>
          </button>
          <button type="button" class="filter-tab-btn" data-filter="bioinformatics" data-active="false">
            <span data-i18n="zh">生物信息</span>
            <span data-i18n="en">Bioinformatics</span>
          </button>
          <button type="button" class="filter-tab-btn" data-filter="ai-agent" data-active="false">
            <span data-i18n="zh">AI & MCP</span>
            <span data-i18n="en">AI & Agents</span>
          </button>
          <button type="button" class="filter-tab-btn" data-filter="opensource" data-active="false">
            <span data-i18n="zh">开源项目</span>
            <span data-i18n="en">Open Source</span>
          </button>
        </div>
      </div>
    </div>

    <div id="project-list" class="divide-y divide-[#d4a75f]">
      {experiences.map((item) => (
        <article
          class="project-item py-6 first:pt-2 last:pb-2 grid grid-cols-1 sm:grid-cols-[150px_1fr] gap-3 sm:gap-6 transition-opacity"
          data-categories={item.categories.join(',')}
          data-search-text={`${item.title.zh} ${item.title.en} ${item.subtitle.zh} ${item.subtitle.en} ${item.techTags.join(' ')} ${item.bullets.zh.join(' ')} ${item.bullets.en.join(' ')}`.toLowerCase()}
        >
          <div class="text-xs text-[#8a5a2b] space-y-1 pt-0.5 pr-2">
            <div class="sv-date">{item.period}</div>
            <div class="leading-relaxed">
              <span data-i18n="zh">{item.organization.zh}</span>
              <span data-i18n="en">{item.organization.en}</span>
            </div>
          </div>

          <div class="space-y-2.5">
            <div class="flex flex-col items-start gap-1.5">
              <h3 class="text-base font-semibold text-[#4a2a14] leading-snug">
                <span data-i18n="zh">{item.title.zh}</span>
                <span data-i18n="en">{item.title.en}</span>
              </h3>
              {item.highlightMetric && (
                <span class="sv-badge">
                  <Sprite name="coin" scale={1} />
                  <span data-i18n="zh">{item.highlightMetric.zh}</span>
                  <span data-i18n="en">{item.highlightMetric.en}</span>
                </span>
              )}
            </div>

            <div class="text-xs sm:text-sm text-[#8a5a2b] leading-relaxed">
              <span class="font-medium text-[#6b4423]">
                <span data-i18n="zh">{item.subtitle.zh}</span>
                <span data-i18n="en">{item.subtitle.en}</span>
              </span>
              <span class="text-[#b98a45] mx-1.5 select-none">/</span>
              <span>
                <span data-i18n="zh">{item.role.zh}</span>
                <span data-i18n="en">{item.role.en}</span>
              </span>
            </div>

            <ul class="space-y-1.5 text-sm text-[#6b4423] pt-0.5">
              {item.bullets.zh.map((bulletZh, idx) => (
                <li class="flex items-baseline gap-2 text-pretty">
                  <span class="text-[#4a2a14] font-mono text-xs select-none">▪</span>
                  <span class="leading-relaxed">
                    <span data-i18n="zh">{bulletZh}</span>
                    <span data-i18n="en">{item.bullets.en[idx]}</span>
                  </span>
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap items-center gap-1.5 pt-1">
              {item.techTags.map((tag) => (
                <span class="academic-tag font-mono text-[11px]">{tag}</span>
              ))}
              {item.links &&
                item.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="academic-action-link"
                  >
                    <span data-i18n="zh">{link.label.zh} ↗</span>
                    <span data-i18n="en">{link.label.en} ↗</span>
                  </a>
                ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div id="project-empty-state" class="hidden py-12 text-center">
      <div class="mx-auto w-24 h-24 mb-3 flex items-center justify-center bg-[#f6e0a4] border border-[#d4a75f]">
        <svg class="w-12 h-12 text-[#a47a45]" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="28" cy="28" r="14" stroke="#8a5a2b" stroke-dasharray="3 3" />
          <path d="M38 38L50 50" stroke="#4a2a14" stroke-width="3" stroke-linecap="round" />
          <path d="M23 26h10M23 31h6" stroke="#8a5a2b" stroke-linecap="round" />
        </svg>
      </div>
      <p class="text-sm font-medium text-[#4a2a14]">
        <span data-i18n="zh">未找到匹配的科研或开源项目</span>
        <span data-i18n="en">No matching research or open-source projects found</span>
      </p>
      <p class="text-xs text-[#8a5a2b] mt-1 mb-4">
        <span data-i18n="zh">可以尝试搜索 Nextflow、ColabFold、Guomics、MCP 或重置筛选条件</span>
        <span data-i18n="en">Try keywords like Nextflow, ColabFold, Guomics, MCP, or reset filters</span>
      </p>
      <button
        id="project-reset-btn"
        type="button"
        class="academic-action-link cursor-pointer"
      >
        <span data-i18n="zh">重置筛选条件</span>
        <span data-i18n="en">Reset Filters</span>
      </button>
    </div>
  </section>

  <!-- 4. Education & Academic Foundation Section -->
  <section id="education" class="py-10 border-b border-[#d4a75f]">
    <SectionTitle icon="sapling" zh="教育背景 · Education" en="Education" class="mb-6" />

    <div class="divide-y divide-[#d4a75f]">
      {education.map((edu) => (
        <div class="py-4 first:pt-0 last:pb-0 grid grid-cols-1 sm:grid-cols-[150px_1fr] gap-3 sm:gap-6">
          <div class="font-mono text-xs text-[#8a5a2b] pt-0.5">
            <div class="sv-date">{edu.period}</div>
            <div class="mt-1.5 flex items-center gap-1" title={`GPA ${edu.gpa}`}>
              {Array.from({ length: 5 }, (_, i) => {
                const f = Math.max(0, Math.min(1, parseFloat(edu.gpa) - i));
                return (
                  <span class="relative inline-block w-[20px] h-[20px]">
                    <Sprite name="heartEmpty" scale={1.7} class="absolute inset-0" />
                    <span class="absolute inset-0 overflow-hidden" style={`width:${f * 100}%`}>
                      <Sprite name="heart" scale={1.7} />
                    </span>
                  </span>
                );
              })}
            </div>
            <div class="mt-1">GPA {edu.gpa}</div>
          </div>

          <div class="space-y-1.5">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <h3 class="text-base font-semibold text-[#4a2a14] leading-snug">
                <span data-i18n="zh">{edu.institution.zh}</span>
                <span data-i18n="en">{edu.institution.en}</span>
                <span class="text-[#b98a45] mx-1.5 select-none">/</span>
                <span class="font-medium text-[#6b4423]">
                  <span data-i18n="zh">{edu.department.zh}</span>
                  <span data-i18n="en">{edu.department.en}</span>
                </span>
              </h3>
            </div>

            <p class="text-sm font-medium text-[#6b4423]">
              <span data-i18n="zh">{edu.degree.zh}</span>
              <span data-i18n="en">{edu.degree.en}</span>
            </p>

            <p class="text-xs sm:text-sm text-[#6b4423] leading-relaxed text-pretty">
              <span data-i18n="zh">{edu.courses.zh}</span>
              <span data-i18n="en">{edu.courses.en}</span>
            </p>

            {edu.extra && (
              <p class="text-xs text-[#8a5a2b] leading-relaxed text-pretty">
                <span data-i18n="zh">{edu.extra.zh}</span>
                <span data-i18n="en">{edu.extra.en}</span>
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. Technical Skills & Honors Section -->
  <section id="skills" class="pt-10 grid grid-cols-1 md:grid-cols-2 gap-10">
    <div>
      <SectionTitle icon="hoe" zh="专业技能 · Tech Stack" en="Technical Stack" class="mb-5" />
      <div class="space-y-4">
        {skills.map((group) => (
          <div class="py-2.5 first:pt-0 border-b border-[#d4a75f] last:border-0 space-y-1">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-[#8a5a2b]">
              <span data-i18n="zh">{group.category.zh}</span>
              <span data-i18n="en">{group.category.en}</span>
            </h3>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {group.items.map((it) => <span class="sv-chip">{it}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div>
      <SectionTitle icon="star" zh="荣誉奖项 · Honors" en="Honors & Awards" class="mb-5" />
      <div class="divide-y divide-[#d4a75f]">
        {honors.map((honor) => (
          <div class="py-3.5 first:pt-0 last:pb-0 space-y-1">
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="text-sm font-semibold text-[#4a2a14] flex items-start gap-2">
                <Sprite name="star" scale={2} class="mt-0.5" />
                <span data-i18n="zh">{honor.title.zh}</span>
                <span data-i18n="en">{honor.title.en}</span>
              </h3>
              <span class="font-mono text-xs text-[#8a5a2b] shrink-0">{honor.year}</span>
            </div>
            <p class="text-xs font-medium text-[#8a5a2b]">
              <span data-i18n="zh">{honor.organization.zh}</span>
              <span data-i18n="en">{honor.organization.en}</span>
            </p>
            <p class="text-xs sm:text-sm text-[#6b4423] text-pretty">
              <span data-i18n="zh">{honor.detail.zh}</span>
              <span data-i18n="en">{honor.detail.en}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const searchInput = document.getElementById('project-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('project-search-clear') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('project-reset-btn') as HTMLButtonElement | null;
    const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
    const emptyState = document.getElementById('project-empty-state');
    const countLabel = document.getElementById('project-count-label');

    let activeCategory = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;
      const totalCount = projectItems.length;

      projectItems.forEach((item) => {
        const categories = (item.getAttribute('data-categories') || '').split(',');
        const searchText = item.getAttribute('data-search-text') || '';

        const matchesCategory = activeCategory === 'all' || categories.includes(activeCategory);
        const matchesSearch = !searchQuery || searchText.includes(searchQuery.toLowerCase());

        if (matchesCategory && matchesSearch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (countLabel) {
        countLabel.textContent = `${visibleCount} / ${totalCount}`;
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      if (clearBtn) {
        if (searchQuery.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.getAttribute('data-filter') || 'all';
        filterButtons.forEach((b) => {
          b.setAttribute('data-active', b === btn ? 'true' : 'false');
        });
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      applyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      applyFilters();
    });

    resetBtn?.addEventListener('click', () => {
      activeCategory = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      filterButtons.forEach((b) => {
        b.setAttribute('data-active', b.getAttribute('data-filter') === 'all' ? 'true' : 'false');
      });
      applyFilters();
    });
  </script>
</BaseLayout>
