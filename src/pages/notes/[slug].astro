---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteData } from '../../data/cv';

export function getStaticPaths() {
  return siteData.researchNotes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
---

<BaseLayout
  title={`${note.title.zh} | 刘一树 (Yishu Liu)`}
  description={note.excerpt.zh}
>
  <article class="max-w-3xl">
    <div class="mb-6">
      <a href="/notes" class="text-xs font-medium text-[#8a5a2b] hover:text-[#4a2a14] transition-colors">
        ← <span data-i18n="zh">返回全部笔记</span><span data-i18n="en">Back to Research Notes</span>
      </a>
    </div>

    <header class="pb-6 border-b border-[#d4a75f] space-y-3">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-[#8a5a2b]">
        <span>{note.date}</span>
        <span>·</span>
        <span>{note.category}</span>
        <span>·</span>
        <span>
          <span data-i18n="zh">{note.readingTime.zh}</span>
          <span data-i18n="en">{note.readingTime.en}</span>
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl tracking-tight text-[#4a2a14] leading-snug">
        <span data-i18n="zh">{note.title.zh}</span>
        <span data-i18n="en">{note.title.en}</span>
      </h1>

      <div class="flex flex-wrap gap-1.5 pt-1">
        {note.tags.map((tag) => (
          <span class="academic-tag font-mono text-xs">{tag}</span>
        ))}
      </div>
    </header>

    <div class="py-8 space-y-5 text-[15px] text-[#4a2a14] leading-relaxed text-pretty">
      {note.content.zh.map((paragraphZh, idx) => (
        <p>
          <span data-i18n="zh">{paragraphZh}</span>
          <span data-i18n="en">{note.content.en[idx]}</span>
        </p>
      ))}
    </div>
  </article>
</BaseLayout>
